# Окружение ТОЛЬКО для e2e-сборки (npm run build:e2e / test:e2e). Секретов здесь нет.
# Supabase указывает на заведомо недоступный адрес: e2e проверяют сценарии без
# реального Auth (редиректы, валидация, отказ при недоступности сервиса).
# SUPABASE_SECRET_KEY намеренно не задан → rate limiter «недоступен» → вход/регистрация
# отвечают «Сервис временно недоступен» (fail closed). Это проверяется тестами.
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_e2e_dummy_not_a_real_key
LOG_LEVEL=error
SITE_ORGANIZATION_SLUG=e2e-school
