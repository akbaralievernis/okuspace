# Шаблон переменных окружения Okuspace Next.
# Скопируйте в .env.local и заполните. Реальные значения НИКОГДА не коммитятся.

# Публичные (попадают в браузер) — только то, что безопасно показывать
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Серверные (только сервер; без префикса NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=
LOG_LEVEL=info

# AI Language Lab (этап 7). По умолчанию AI выключен (none) — обучение работает без него.
# Ключ — только на сервере; включение для школы — в «AI школы» (директор, MFA).
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Онлайн-оплата (этап 9). Пусто = webhook закрыт (404). Секрет — не короче 32 символов.
# Данные карт платформа не получает и не хранит: только идентификатор операции провайдера.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# Плановые задачи и уведомления (этап 11). Планировщик вызывает /api/cron/notifications
# с заголовком Authorization: Bearer <CRON_SECRET> (Vercel Cron делает это сам). Не короче 32 символов.
CRON_SECRET=
# Email: resend | none. Без ключа письма не отправляются (доставка помечается «пропущено»).
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=
# Telegram-бот: токен от @BotFather, секрет webhook (не короче 32 символов), имя бота без @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Школа, которую показывает публичный сайт (slug из organizations)
SITE_ORGANIZATION_SLUG=
